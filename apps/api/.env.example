# Copy to .env (git-ignored) and fill in. Production sets these in the host's secret settings
# instead; the API refuses to start in production with unsafe or missing values, listing them all.
# Full list and deployment notes: docs/deploy.md

# Free keys: https://api.podcastindex.org/signup. Quote the secret if it contains a #.
PODCAST_INDEX_KEY=
PODCAST_INDEX_SECRET=

# Signs access tokens. Required in production, at least 32 characters: `openssl rand -base64 32`.
# Keep it: changing it signs everyone out.
# AUTH_SECRET=

# Where the web app is served (exact origin). Sign-in links and shared episode links point there,
# and it's the origin allowed to call the API with credentials. Must be https in production.
# WEB_URL=http://localhost:8081

# Extra comma-separated origins allowed to call the API (defaults to WEB_URL only).
# CORS_ORIGINS=http://localhost:8081

# Sign-in emails: log (development: written to this server's log), resend or postmark.
# EMAIL_PROVIDER=log
# EMAIL_API_KEY=
# EMAIL_FROM=Podcasts <sign-in@your-domain.com>

# Behind a load balancer or proxy: true, a hop count (e.g. 1), or proxy addresses/CIDRs. Needed
# for per-client rate limits, https detection (secure cookies, HSTS) and correct share links.
# TRUST_PROXY=1

# PostgreSQL for the catalog and accounts. Without DATABASE_URL the API keeps everything in
# memory, lost on every restart. Create the databases with: createdb podcast && createdb podcast_test
DATABASE_URL=postgres://localhost:5432/podcast
# Used by `pnpm test` for the store tests; skipped when unset. Tests wipe this database, which
# needs the pgvector extension (see docs/deploy.md).
TEST_DATABASE_URL=postgres://localhost:5432/podcast_test

# Apply migrations on startup (default true). Set false when running `migrate` as a release step.
# MIGRATE_ON_START=true
# PORT=4000
# LOG_LEVEL=info
