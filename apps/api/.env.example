# Copy to .env (git-ignored) and fill in. Free keys: https://api.podcastindex.org/signup
PODCAST_INDEX_KEY=
PODCAST_INDEX_SECRET=

# Where the web app is served. Shared episode links (/s/e/:id) send people on to its episode pages.
# WEB_URL=http://localhost:8081

# Comma-separated origins allowed to call the API; defaults to any origin.
# CORS_ORIGINS=http://localhost:8081

# PostgreSQL for the catalog. Without DATABASE_URL the API keeps the catalog in memory,
# and it's lost on every restart. Create the databases with: createdb podcast && createdb podcast_test
DATABASE_URL=postgres://localhost:5432/podcast
