# Copy to .env (git-ignored). The content worker fetches transcripts, builds excerpts, embeds and
# recommends, using the same database as the API (which needs the pgvector extension).
DATABASE_URL=postgres://localhost:5432/podcast

# dLogos Partner Episode API: the main transcript source. Without it, only publisher transcripts.
# DLOGOS_API_KEY=

# dLogos requests per day for building the discovery corpus (0 = only on highlights).
# DLOGOS_SEED_DAILY_BUDGET=0
# dLogos requests per day triggered by highlights (a guard against bursts and abuse).
# DLOGOS_REQUEST_DAILY_BUDGET=500

# Embeddings: off (default), openai, or hashing (local, no network; for trying discovery only).
# openai sends episode text and listeners' highlight notes to OpenAI.
# EMBEDDINGS_PROVIDER=off
# OPENAI_API_KEY=

# HNSW search accuracy/speed trade-off (pgvector default 40).
# HNSW_EF_SEARCH=100
# LOG_LEVEL=info
